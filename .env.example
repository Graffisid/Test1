# Variable names only. Never put a real value in this file or in the repo.
# Real values go in .env (gitignored) locally and in the host's secret store in production.
# If a key is ever committed, rotate it. Deleting the commit is not enough.

# --- Mode ---
# "mock" stubs every external integration. Nothing real is called while MOCK_MODE=mock.
MOCK_MODE=

# --- Database (Supabase / Postgres) ---
# Admin connection for migrations/seed. The dashboard uses its own least-privilege login (dashboard/.env.example).
DATABASE_URL=
# Password for the dashboard_login role, read once by `npm run db:create-dashboard-login`.
DASHBOARD_DB_PASSWORD=
# Set to 1 ONLY to let db:seed / db:reset run against a non-local database (they wipe data).
ALLOW_DESTRUCTIVE_DB=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (brain + subagents) ---
ANTHROPIC_API_KEY=

# --- Meta (Marketing API, Instagram Graph API, Ad Library) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=

# --- TikTok Business ---
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# --- ElevenLabs (voiceovers + conversational voice agent) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Twilio (telephony) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Higgsfield (product photo → video) ---
HIGGSFIELD_API_KEY=

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# --- Approval bot: Telegram or Slack ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL_ID=

# --- Spend caps (enforced in code; MUSE.md holds the authoritative values) ---
SPEND_CAP_WEEKLY_CAD=
SPEND_CAP_PER_AD_DAILY_CAD=
SPEND_CIRCUIT_BREAKER_DAILY_CAD=
