# Variable names only. Never put a real value in this file or in the repo.
# Real values go in .env (gitignored) locally and in the host's secret store in production.
# If a key is ever committed, rotate it. Deleting the commit is not enough.

# --- Database ---
# Admin connection for migrations only. Every service uses its own least-privilege login.
DATABASE_URL=
# Password for a service login, read once by `npm run db:create-login -- dashboard|oncu|video|mailer`.
DB_LOGIN_PASSWORD=
# Set to 1 ONLY to let db:reset run against a non-local database (it wipes data).
ALLOW_DESTRUCTIVE_DB=

# --- ONCU Insights (read-only) ---
ONCU_SYNC_DATABASE_URL=
# A git checkout of Graffisid/oncu-app (default ../oncu-app); oncu:auto reads its committed main branch.
ONCU_REPO_DIR=
ONCU_BRANCH=
ONCU_AUTO_HOURS=
# Or a plain folder holding registry.json and credit-unions/ (for oncu:sync).
ONCU_DATA_DIR=

# --- Video studio ---
VIDEO_DATABASE_URL=
VIDEO_DIR=
# Optional: path to Playwright's index.mjs if it isn't in node_modules; ffmpeg path if not on PATH.
PLAYWRIGHT_MODULE=
FFMPEG_PATH=

# --- Sharing ---
MAILER_DATABASE_URL=
# "outbox" is the only mode in this build: approved messages are written as .eml files, nothing is emailed.
MAIL_MODE=
OUTBOX_DIR=
