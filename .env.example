# Variable names only. Never put a real value in this file or in the repo.
# Real values go in .env (gitignored) locally and in the host's secret store in production.
# If a key is ever committed, rotate it. Deleting the commit is not enough.

# --- Mode ---
# "mock" stubs every external integration. Nothing real is called while MOCK_MODE=mock.
MOCK_MODE=

# --- Database (Supabase / Postgres) ---
# Admin connection for migrations/seed. The dashboard uses its own least-privilege login (dashboard/.env.example).
DATABASE_URL=
# Password for a service login role, read once by `npm run db:create-login -- dashboard|ingest|brain|publisher|media|spend|qualifier|voice`.
DB_LOGIN_PASSWORD=
# The webhook receiver / poller / review import connect as a login in ingest_app (never the superuser).
INGEST_DATABASE_URL=
# Set to 1 ONLY to let db:seed / db:reset run against a non-local database (they wipe data).
ALLOW_DESTRUCTIVE_DB=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (brain + subagents) ---
# The brain uses a deterministic MOCK model unless LLM_MODE=live (and MOCK_MODE is not "mock").
# Live calls are paid. They are capped per day in code by LLM_DAILY_BUDGET_CAD (default 2).
LLM_MODE=
LLM_MODEL=
LLM_DAILY_BUDGET_CAD=
ANTHROPIC_API_KEY=
# Least-privilege logins (npm run db:create-login -- brain | publisher | media | spend)
BRAIN_DATABASE_URL=
PUBLISHER_DATABASE_URL=
MEDIA_DATABASE_URL=
SPEND_DATABASE_URL=
# media-producer stops and escalates before a batch would cost more than this (default 25).
MEDIA_BATCH_THRESHOLD_CAD=
# Lead capture + callback (npm run db:create-login -- qualifier | voice)
QUALIFIER_DATABASE_URL=
VOICE_DATABASE_URL=
# Signs capture and opt-out links (32+ random characters). Rotating it invalidates outstanding links.
CAPTURE_LINK_SECRET=
# Public HTTPS base URL of the receiver (capture links point here).
PUBLIC_BASE_URL=
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For (used for form rate limiting).
TRUST_PROXY=

# --- Meta (Marketing API, Instagram Graph API, Ad Library) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=
# Webhook receiver bind address (Meta needs public HTTPS → put a TLS proxy/tunnel in front).
INGEST_HOST=
INGEST_PORT=
# Where `npm run simulate:meta` sends signed test deliveries.
INGEST_URL=

# --- TikTok Business ---
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# --- ElevenLabs (voiceovers + conversational voice agent) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Twilio (telephony) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Higgsfield (product photo → video) ---
HIGGSFIELD_API_KEY=

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# --- Approval bot: Telegram or Slack ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL_ID=

# --- Spend caps ---
# Enforced by the database (table spend_caps, migration 017), not by env vars. Values mirror MUSE.md;
# a test fails if they drift apart. Change them with a migration, never at runtime.
