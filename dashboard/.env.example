# Dashboard environment. Copy to dashboard/.env.local (gitignored) and fill in. Never commit real values.

# Least-privilege login role that is a member of dashboard_app (NOT the postgres superuser).
#   DB_LOGIN_PASSWORD=... npm run db:create-login -- dashboard   (from the repo root)
DATABASE_URL=

# Owner sign-in password: at least 12 characters (a long passphrase is best).
DASHBOARD_PASSWORD=

# Signs session cookies: at least 32 random characters, e.g. `openssl rand -base64 48`.
# Changing it signs everyone out.
SESSION_SECRET=

# Hosts the dashboard will answer to (DNS-rebinding protection). Default: 127.0.0.1:3000,localhost:3000
ALLOWED_HOSTS=

# Name recorded on approvals.
OWNER_NAME=

# Where the video worker writes videos and the mailer writes email files (defaults: ../.videos and ../.outbox).
VIDEO_DIR=
OUTBOX_DIR=
